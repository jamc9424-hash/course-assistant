# Copy to `.env` locally and fill in real values. NEVER commit the copied file.
#
# Class services live on dobolyi.com, ports 9001-9005. The port-to-service
# mapping below was verified against each service's live /v1/models in this
# branch, and matches the model served on that port.
#
#   :9001  Vision-capable LLM        (cyankiwi/Qwen3.6-35B-A3B-AWQ-4bit)
#   :9002  Text embeddings           (nvidia/Nemotron-3-Embed-1B-BF16)
#   :9003  Visual embeddings         (Qwen/Qwen3-VL-Embedding-2B)
#   :9004  Multimodal reranker       (Qwen/Qwen3-VL-Reranker-2B)
#   :9005  Document parser / OCR     (dots.mocr)

CLASS_SERVICE_API_KEY=replace-with-local-dummy-value

VISION_LLM_URL=http://dobolyi.com:9001
TEXT_EMBEDDING_URL=http://dobolyi.com:9002
VISUAL_EMBEDDING_URL=http://dobolyi.com:9003
RERANKING_URL=http://dobolyi.com:9004
DOCUMENT_PARSER_URL=http://dobolyi.com:9005

# Model names (match each service's /v1/models).
VISION_MODEL=cyankiwi/Qwen3.6-35B-A3B-AWQ-4bit
TEXT_EMBED_MODEL=nvidia/Nemotron-3-Embed-1B-BF16
VISUAL_EMBED_MODEL=Qwen/Qwen3-VL-Embedding-2B
RERANK_MODEL=Qwen/Qwen3-VL-Reranker-2B
PARSER_MODEL=dots.mocr

# Retrieval tuning (optional overrides).
# CHUNK_SIZE=600
# CHUNK_OVERLAP=120
# TEXT_TOP_K=6
# VISUAL_TOP_K=4
# KEYWORD_TOP_K=6
# RERANK_TOP_N=6
# USE_RERANK=1
