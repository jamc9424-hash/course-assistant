# Copy to .env locally; never commit the copied file.
# The real class API key must remain server-side and is intentionally omitted.
CLASS_SERVICE_API_KEY=replace-with-local-dummy-value
# The supplied class endpoints use HTTP. Set true only on the trusted class network;
# use HTTPS in production whenever available.
CLASS_SERVICE_ALLOW_INSECURE_HTTP=true

TEXT_EMBEDDING_BASE_URL=http://dobolyi.com:9002
TEXT_EMBEDDING_ENDPOINT=http://dobolyi.com:9002/v2/embed
TEXT_EMBEDDING_MODEL=nvidia/Nemotron-3-Embed-1B-BF16

VISUAL_EMBEDDING_BASE_URL=http://dobolyi.com:9003/v1
VISUAL_EMBEDDING_ENDPOINT=http://dobolyi.com:9003/v1/embeddings
VISUAL_EMBEDDING_MODEL=Qwen/Qwen3-VL-Embedding-2B

RERANKER_BASE_URL=http://dobolyi.com:9004
RERANKER_ENDPOINT=http://dobolyi.com:9004/rerank
RERANKER_MODEL=Qwen/Qwen3-VL-Reranker-2B

DOCUMENT_PARSER_BASE_URL=http://dobolyi.com:9005/v1
DOCUMENT_PARSER_ENDPOINT=http://dobolyi.com:9005/v1/chat/completions
DOCUMENT_PARSER_MODEL=dots.mocr
